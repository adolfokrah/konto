{
  "crons": [
    {
      "path": "/api/contributions/verify-pending-transactions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/notifications/cleanup-old-notifications",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/users/send-kyc-reminder",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/users/send-jar-creation-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/users/send-empty-jar-reminder",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "usehoga.com"
        }
      ],
      "destination": "https://hogapay.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.usehoga.com"
        }
      ],
      "destination": "https://hogapay.com/:path",
      "permanent": true
    }
  ]
}
